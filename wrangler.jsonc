{
  "name": "cubedax",
  "main": "worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/ws"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "HUB", "class_name": "GameHub" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameHub"] }
  ]
}
